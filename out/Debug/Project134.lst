     1                                  ; Project134 — AMI486 BIOS reconstruction
     2                                  ; NASM-only executable implementation. Reference ROM is analysis-only.
     3                                  ; FFh fill is reserved for regions not yet reconstructed.
     4                                  
     5                                  BITS 16
     6                                  ORG 0
     7                                  %ifndef ROM_SIZE
     8                                      %define ROM_SIZE 65536
     9                                  %endif
    10                                  %if ROM_SIZE != 65536
    11                                      %error "AMI486 BIOS image must be exactly 64 KiB"
    12                                  %endif
    13                                  rom_start:
    14                                  
    15                                  ; Encode a 16-bit near jump to an absolute offset in the current CS.
    16                                  ; NASM's numeric JMP operand is a displacement, not an absolute IP.
    17                                  %macro JMP_ABS 1
    18                                      ; NASM treats a numeric near-JMP operand as the absolute target offset
    19                                      ; and calculates the signed relative displacement itself.
    20                                      jmp near %1
    21                                  %endmacro
