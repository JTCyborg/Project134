<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{134B1050-4860-4A00-9B13-134000000001}</ProjectGuid>
    <Keyword>MakeFileProj</Keyword>
    <ProjectName>Project134.BIOS</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup>
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(SolutionDir)out\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\</IntDir>
    <NasmExe Condition="'$(NasmExe)'==''">nasm.exe</NasmExe>
    <RomSize Condition="'$(RomSize)'==''">65536</RomSize>
  </PropertyGroup>
  <ItemGroup>
    <CustomBuild Include="$(ProjectDir)src\reset.asm">
      <Message>Assembling Project134 bootstrap BIOS (16-bit real mode)</Message>
      <Command>"$(NasmExe)" -f bin -DROM_SIZE=$(RomSize) -o "$(OutDir)Project134.bin" "%(FullPath)"</Command>
      <Outputs>$(OutDir)Project134.bin</Outputs>
    </CustomBuild>
    <None Include="$(ProjectDir)tools\validate_rom.ps1" />
    <None Include="$(ProjectDir)README.md" />
  </ItemGroup>
  <Target Name="ValidateProject134Rom" AfterTargets="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\validate_rom.ps1&quot; -RomPath &quot;$(OutDir)Project134.bin&quot; -ExpectedSize $(RomSize)" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
