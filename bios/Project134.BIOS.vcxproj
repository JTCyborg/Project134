<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{134B1050-4860-4A00-9B13-134000000001}</ProjectGuid>
    <Keyword>MakeFileProj</Keyword>
    <ProjectName>Project134.BIOS</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup>
    <ConfigurationType>Makefile</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- Anchor output to this project, not SolutionDir (which can be empty or
         point elsewhere when the project is opened outside the solution). -->
    <OutDir>$(MSBuildProjectDirectory)\..\out\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\..\obj\$(Configuration)\</IntDir>
    <!-- build_bios.ps1 resolves NASM from PATH or the local vcpkg tool cache. -->
    <NasmExe Condition="'$(NasmExe)'==''">nasm.exe</NasmExe>
    <RomSize Condition="'$(RomSize)'==''">65536</RomSize>
    <NMakeBuildCommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\tools\build_bios.ps1" -OutputDirectory "$(OutDir)" -NasmExe "$(NasmExe)" -RomSize $(RomSize)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>$(NMakeBuildCommandLine)</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>if exist "$(OutDir)Project134.bin" del /Q "$(OutDir)Project134.bin"</NMakeCleanCommandLine>
    <NMakeOutput>$(OutDir)Project134.bin</NMakeOutput>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(ProjectDir)src\reset.asm" />
    <None Include="$(ProjectDir)tools\build_bios.ps1" />
    <None Include="$(ProjectDir)tools\validate_rom.ps1" />
    <None Include="$(ProjectDir)README.md" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
